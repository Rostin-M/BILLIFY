{
  "name": "billify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "next lint && tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:backup": "bash scripts/backup.sh",
    "db:studio": "prisma studio",
    "dev": "next dev",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "sonar:down": "docker compose -f docker-compose.sonar.yml down",
    "sonar:scan": "npm run test:db:up && npm run test:coverage && docker compose -f docker-compose.sonar.yml run --rm scanner",
    "sonar:up": "docker compose -f docker-compose.sonar.yml up -d sonarqube",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/normalize-lcov.mjs",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@getbrevo/brevo": "^5.0.4",
    "@prisma/client": "^6.6.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.106.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.17.0",
    "next": "15.5.26",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "superjson": "^2.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.23.0",
    "eslint-config-next": "15.5.26",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vitest": "^5.0.2"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "npm@11.14.1",
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.5"
  }
}
